{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.js",
      "{workspaceRoot}/.prettierrc",
      "{workspaceRoot}/.nvmrc"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.stories.ts",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/eslint.config.js"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        {
          "env": "BROWSERS"
        }
      ],
      "cache": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "continuous": true
    },
    "e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        {
          "env": "BROWSERS"
        }
      ],
      "cache": true
    },
    "visual": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        {
          "env": "PLAYWRIGHT_IMAGE"
        }
      ],
      "cache": true
    },
    "test-storybook": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        {
          "env": "BROWSERS"
        }
      ],
      "cache": true
    }
  },
  "neverConnectToCloud": true,
  "analytics": false
}
