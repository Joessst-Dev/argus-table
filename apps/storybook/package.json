{
  "name": "@argus-table/storybook",
  "private": true,
  "type": "module",
  "nx": {
    "name": "storybook",
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/benchmarks/published/**/*",
          "{workspaceRoot}/benchmarks/markdown.ts",
          "{workspaceRoot}/benchmarks/types.ts"
        ]
      }
    }
  },
  "scripts": {
    "storybook": "storybook dev --port 6006",
    "build": "storybook build --output-dir dist",
    "test-storybook": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@argus-table/header-menu": "workspace:*",
    "@argus-table/themes": "workspace:*",
    "argus-table": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/web-components": "^10.6.5",
    "@storybook/web-components-vite": "^10.6.5",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "1.63.0",
    "storybook": "^10.6.5",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
