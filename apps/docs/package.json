{
  "name": "@argus-table/docs",
  "private": true,
  "type": "module",
  "nx": {
    "name": "docs",
    "implicitDependencies": [
      "skills"
    ],
    "targets": {
      "sync": {
        "cache": false
      },
      "lint": {
        "dependsOn": [
          "^build",
          "sync"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^build",
          "sync"
        ]
      },
      "e2e": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "BROWSERS"
          },
          {
            "env": "E2E_SHARD"
          },
          "{workspaceRoot}/skills/argus-table-integrate/references/**/*.md",
          "{workspaceRoot}/packages/*/README.md",
          "{workspaceRoot}/benchmarks/published/**/*",
          "{workspaceRoot}/benchmarks/markdown.ts",
          "{workspaceRoot}/benchmarks/types.ts"
        ]
      },
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/brand/**/*",
          "{workspaceRoot}/packages/table/package.json",
          "{workspaceRoot}/skills/argus-table-integrate/references/**/*.md",
          "{workspaceRoot}/packages/*/README.md",
          "{workspaceRoot}/benchmarks/published/**/*",
          "{workspaceRoot}/benchmarks/markdown.ts",
          "{workspaceRoot}/benchmarks/types.ts"
        ],
        "dependsOn": [
          "^build",
          "sync"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^production",
          {
            "env": "BROWSERS"
          },
          "{workspaceRoot}/skills/argus-table-integrate/references/**/*.md",
          "{workspaceRoot}/packages/*/README.md",
          "{workspaceRoot}/benchmarks/published/**/*",
          "{workspaceRoot}/benchmarks/markdown.ts",
          "{workspaceRoot}/benchmarks/types.ts"
        ]
      }
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321 --host 0.0.0.0",
    "sync": "astro sync",
    "typecheck": "astro check && tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.vue.json --noEmit && ngc -p tsconfig.angular.json",
    "lint": "eslint . && node scripts/check-examples.mjs",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@analogjs/astro-angular": "^2.9.8",
    "@analogjs/vite-plugin-angular": "^2.9.8",
    "@angular/animations": "^22.2.6",
    "@angular/build": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@argus-table/angular": "workspace:*",
    "@argus-table/editing": "workspace:*",
    "@argus-table/export": "workspace:*",
    "@argus-table/formulas": "workspace:*",
    "@argus-table/header-menu": "workspace:*",
    "@argus-table/react": "workspace:*",
    "@argus-table/theme-creator": "workspace:*",
    "@argus-table/themes": "workspace:*",
    "@argus-table/vue": "workspace:*",
    "@astrojs/react": "^7.1.9",
    "@astrojs/starlight": "^0.43.1",
    "@astrojs/vue": "^7.1.6",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "argus-table": "workspace:*",
    "astro": "^7.4.13",
    "lit": "^3.3.3",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@argus-table/generate-wrappers": "workspace:*",
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
