---
// One element's API reference, generated from the Custom Elements Manifest.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import RefTable from '../../components/api/RefTable.astro';
import { ELEMENT_TAGS } from '../../lib/api/elements';
import { code, docHtml, elementOf, rowId, typeHtml } from '../../lib/api/site';

export function getStaticPaths() {
  return ELEMENT_TAGS.map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag as (typeof ELEMENT_TAGS)[number];
const el = elementOf(tag);

const bindings = (b: { react: string; vue: string; angular: string }) =>
  `React ${code(b.react)}<br />Vue ${code(b.vue)}<br />Angular ${code(b.angular)}`;

const sections = [
  {
    id: 'properties',
    title: 'Properties',
    columns: ['Property', 'Bindings', 'Type', 'Description'],
    rows: el.properties.map((p) => ({
      id: rowId('property', p.name),
      cells: [
        code(p.name) + (p.attribute ? `<br />attribute ${code(p.attribute)}` : ''),
        bindings(p),
        typeHtml(p.type),
        docHtml(p.description),
      ],
    })),
  },
  {
    id: 'events',
    title: 'Events',
    columns: ['Event', 'Bindings', 'Type', 'Description'],
    rows: el.events.map((e) => ({
      id: rowId('event', e.name),
      cells: [
        code(e.name) + (e.from ? `<br />from ${code(e.from)}` : ''),
        bindings(e),
        typeHtml(e.type),
        docHtml(e.description),
      ],
    })),
  },
  {
    id: 'methods',
    title: 'Methods',
    columns: ['Method', 'Description'],
    rows: el.methods.map((m) => ({
      id: rowId('method', m.name),
      cells: [typeHtml(m.signature), docHtml(m.description)],
    })),
  },
  {
    id: 'slots',
    title: 'Slots',
    columns: ['Slot', 'Description'],
    rows: el.slots.map((s) => ({
      id: rowId('slot', s.name),
      cells: [code(s.name), docHtml(s.description)],
    })),
  },
  {
    id: 'parts',
    title: 'Parts',
    columns: ['Part', 'Description'],
    rows: el.parts.map((p) => ({
      id: rowId('part', p.name),
      cells: [code(p.name), docHtml(p.description)],
    })),
  },
  {
    id: 'tokens',
    title: 'Tokens',
    columns: ['Token', 'Default', 'Description'],
    rows: el.tokens.map((t) => ({
      id: rowId('token', t.name),
      cells: [code(t.name), t.default ? code(t.default) : '—', docHtml(t.description)],
    })),
  },
].filter((s) => s.rows.length > 0);
---

<StarlightPage
  frontmatter={{ title: `<${tag}>`, description: `The API of <${tag}>: ${sections.map((s) => s.title.toLowerCase()).join(', ')}.` }}
  headings={sections.map((s) => ({ depth: 2, slug: s.id, text: s.title }))}
>
  <Fragment set:html={docHtml(el.description)} />
  <p>
    The class is <code>{el.className}</code>, exported by <code>argus-table</code>. Bindings are how
    the React, Vue and Angular wrappers name each property and event.
  </p>
  {
    sections.map((s) => (
      <>
        <h2 id={s.id}>{s.title}</h2>
        <RefTable columns={s.columns} rows={s.rows} />
      </>
    ))
  }
</StarlightPage>
