---
// The note on the migration pages: the guides serve the integrate skill too.
import { Aside } from '@astrojs/starlight/components';
import { GITHUB_BLOB } from '../../lib/migration';

interface Props {
  /** A guide with a fit table, the gaps page, or the overview of the guides. */
  page: 'guide' | 'gaps' | 'overview';
}

const { page } = Astro.props;
---

<Aside type="tip" title="Also an agent skill">
  {
    page === 'overview' ? (
      <>
        These guides are also references of the <code>argus-table-integrate</code> agent skill,
        which reads them when it migrates an app to argus-table. They're written for both: a table
        per feature with how well it fits, then the code.
      </>
    ) : page === 'gaps' ? (
      <>
        This page is also a reference of the <code>argus-table-integrate</code> agent skill, which
        reads it when it migrates an app to argus-table.
      </>
    ) : (
      <>
        This page is also a reference of the <code>argus-table-integrate</code> agent skill, which
        reads it when it migrates an app to argus-table. It's written for both: a table per feature
        with how well it fits, then the code.
      </>
    )
  }{' '}
  <a href={`${GITHUB_BLOB}skills/README.md`}>About the skills</a>
</Aside>
