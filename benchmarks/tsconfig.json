{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Runs from source with Node's type stripping: `.ts` imports, erasable syntax only.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["*.ts"]
}
