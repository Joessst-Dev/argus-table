{
  "name": "@argus-table/angular",
  "version": "0.2.1",
  "description": "Angular components for argus-table: typed inputs, outputs and two-way binding for <argus-table> and <argus-column>.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joessst-Dev/argus-table.git",
    "directory": "packages/angular"
  },
  "type": "module",
  "nx": {
    "name": "angular",
    "implicitDependencies": [
      "generate-wrappers"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/types/argus-table-angular.d.ts",
      "default": "./dist/fesm2022/argus-table-angular.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/argus-table-angular.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/clean-dist.mjs && publint --strict && attw --pack . --profile esm-only",
    "generate": "node ../../tools/generate-wrappers/src/cli.ts angular",
    "typecheck": "tsc -p tsconfig.json --noEmit && ngc -p tsconfig.types.json",
    "lint": "node ../../tools/generate-wrappers/src/cli.ts angular --check && eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "argus-table": "workspace:^",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "devDependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/browser-playwright": "^5.1.0",
    "ng-packagr": "^22.2.6",
    "playwright": "1.63.0",
    "publint": "^0.3.25",
    "rxjs": "^7.8.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
