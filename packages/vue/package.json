{
  "name": "@argus-table/vue",
  "version": "0.4.0",
  "description": "Vue components for argus-table: typed props, events and v-model for <argus-table> and <argus-column>.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joessst-Dev/argus-table.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "nx": {
    "name": "vue",
    "implicitDependencies": [
      "generate-wrappers"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && publint --strict && attw --pack . --profile esm-only",
    "generate": "node ../../tools/generate-wrappers/src/cli.ts vue",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "node ../../tools/generate-wrappers/src/cli.ts vue --check && eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "argus-table": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "1.63.0",
    "publint": "^0.3.25",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
