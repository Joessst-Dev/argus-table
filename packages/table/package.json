{
  "name": "argus-table",
  "version": "0.0.1",
  "description": "A framework-agnostic data table web component built with Lit and TanStack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joessst-Dev/argus-table.git",
    "directory": "packages/table"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/argus-table.js"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cem analyze",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "1.63.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "customElements": "dist/custom-elements.json",
  "publishConfig": {
    "access": "public"
  }
}
