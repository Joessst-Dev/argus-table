{
  "name": "argus-table",
  "version": "0.0.0",
  "description": "A framework-agnostic data table web component built with Lit and TanStack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joessst-Dev/argus-table.git",
    "directory": "packages/table"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/argus-table.js"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "1.63.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
