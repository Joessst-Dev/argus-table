{
  "name": "argus-table",
  "version": "0.2.2",
  "description": "A framework-agnostic data table web component built with Lit and TanStack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joessst-Dev/argus-table.git",
    "directory": "packages/table"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/cdn/argus-table.js",
  "unpkg": "./dist/cdn/argus-table.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/argus-column.js",
    "./dist/argus-table.js",
    "./dist/cdn/argus-table.js"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.cdn.config.ts && rollup -c rollup.dts.config.mjs && cem analyze && pnpm check-exports",
    "check-exports": "node scripts/check-dist.mjs && publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/lit-virtual": "^3.15.3",
    "@tanstack/table-core": "9.3.1",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@argus-table/core": "workspace:*",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@size-limit/file": "^14.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "lightningcss": "1.33.0",
    "playwright": "1.63.0",
    "publint": "^0.3.25",
    "rollup": "~4.64.12",
    "rollup-plugin-dts": "^6.5.1",
    "size-limit": "^14.3.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "customElements": "dist/custom-elements.json",
  "publishConfig": {
    "access": "public"
  }
}
