{
  "name": "argus-table-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10.28"
  },
  "scripts": {
    "dev": "nx run storybook:storybook",
    "play": "nx run playground:dev",
    "bench": "pnpm --filter @argus-table/benchmarks bench",
    "lint": "nx run-many -t lint typecheck",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t e2e",
    "test:visual": "sh scripts/visual.sh",
    "build": "nx run-many -t build",
    "size": "nx run-many -t build -p argus-table formulas export && pnpm --filter argus-table --filter @argus-table/formulas --filter @argus-table/export size",
    "affected": "nx affected -t lint test build",
    "graph": "nx graph",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm --filter @argus-table/examples sync-versions",
    "release": "nx run-many -t build --skip-nx-cache --exclude=storybook && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "nx": "~24.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
